<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TapPrint third-party licences</title>
<style>
body { font: 15px/1.5 system-ui, sans-serif; max-width: 860px; margin: 2rem auto; padding: 0 1rem; color: #1f2328; }
pre { white-space: pre-wrap; background: #f6f8fa; padding: 1rem; border-radius: 6px; font-size: 12px; }
li { margin: 0.2rem 0; }
</style>
</head>
<body>
<h1>Third-party licences</h1>
<p>TapPrint is MIT licensed. It is built with the open source software below. See also THIRD_PARTY_NOTICES.md in the source code, which covers libusb (LGPL-2.1), bundled into every build.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licence texts</h2>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
